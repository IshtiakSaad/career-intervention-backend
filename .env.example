# Production Environment Configuration

Copy this to `.env` on your production server.

## 1. System
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

## 2. Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DB_URL=postgresql://johndoe:mypassword@localhost:5432/career_db

## 3. Security
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=your_very_log_random_access_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_very_log_random_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY_V1=your_32_character_encryption_key_here

## 4. Admin Credentials (For Seeding)
SUPER_ADMIN_EMAIL=admin@platform.com
SUPER_ADMIN_PASSWORD=change_this_immediately

## 5. Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

## 6. AI Integration (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key

## 7. Email Integration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

## 8. Financials (SSLCommerz)
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_SANDBOX=false
SSL_BASE_URL=https://securepay.sslcommerz.com

## 9. Caching (Redis)
REDIS_URL=redis://:password@your-redis-host:6379
